# ------------------------------------------------------------------
# ELEXA LIVE PROJECT - ENVIRONMENT CONFIGURATION
# ------------------------------------------------------------------
# SECURITY WARNING:
# - NEVER commit the actual .env file to git.
# - The "Site" (Frontend) only sees variables starting with VITE_
# - The "Agent" (Backend/OpenClaw) sees EVERYTHING.
# ------------------------------------------------------------------

# ==========================================
# 🧠 TIER 1: OPENCLAW AGENT (The Brain)
# Access: Full Control (Socials, AI, Admin)
# ==========================================
# The Token used to control the local OpenClaw Gateway
OPENCLAW_ADMIN_TOKEN=

# Social Bot Tokens (If running bots from this repo)
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# AI Provider (Grok/OpenAI via OpenRouter)
OPENROUTER_API_KEY=

# ==========================================
# 🛠️ TIER 2: SYNC SERVICE (The Hand)
# Access: on-chain Signing (Private Keys)
# ==========================================
# High-speed RPC (Helius/Triton) for backend transactions
SOLANA_RPC_URL=https://api.devnet.solana.com

# The Wallet that pays for automated transactions (Sync/Council)
# FORMAT: Base58 String (e.g., 5M...) or Path to id.json
WALLET_PRIVATE_KEY=

# ==========================================
# 🌐 TIER 3: ELEXA LIVE SITE (The Face)
# Access: Public Read-Only (Safe for Browser)
# NOTE: These MUST start with VITE_ to be visible in the app.
# ==========================================
# Public RPC (can be rate-limited, used for read-only)
VITE_SOLANA_RPC=https://api.devnet.solana.com

# The Program ID of the Elexa World Anchor Program
VITE_PROGRAM_ID=Fg6PaFpoGXkYsidMpWTK6W2BeZ7FEfcYkg476zPFsLnS

# The Gateway Connection (Localhost for now)
VITE_GATEWAY_URL=http://localhost:18789
